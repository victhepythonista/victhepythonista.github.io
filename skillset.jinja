
{% extends "./base.jinja" %}
{% block content %}
<style>
.skill-box {
  margin: 0.5rem;
  padding: 1rem 0.75rem;
  border: 1px solid var(--surface-color);
  border-radius: 10px;
  background-color: #252525;
  color: #00ff00;
  text-align: center;
  font-weight: 900;
  font-size: clamp(1.3rem, 1.4vw, 2.4rem);
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
  transition: transform 0.2s ease, border-color 0.2s ease,
    box-shadow 0.2s ease, background-color 0.2s ease;
  box-shadow: 0 8px 16px var(--surface-color);

}

.skill-box:hover {
  transform: translateY(-4px);
}

/* Improve spacing and alignment */
.skill-row {
  justify-content: center;
  gap: 0.5rem 0;
}

/* Better layout on smaller screens */
@media (max-width: 768px) {
  .skill-box {
    flex: 0 0 45%;
    max-width: 45%;
  }
}

@media (max-width: 480px) {
  .skill-box {
    flex: 0 0 90%;
    max-width: 90%;
  }
}


	.grid-post{
  background-color:var(--nav-hover-color);
  color:#343232;
  padding: 10px;
  border-radius: 20px;
  box-shadow: 0 3px 10px #f0f00f;

	}

	.grid-post h2{
		color:#343232 !important;
	}
	.grid-post h3 , h4 , h5{
		color: #0c0e2f;
	}


  .article-title{
  width: 20ch; /* SHORTCUT: 18ch equals exactly 18 characters wide */
  white-space: nowrap;
  overflow: hidden;
  animation: type 6s steps(20) infinite; /* Matches character count exactly */
  display: flex;
  transition:all ease-in-out;
  text-align: center;
  padding-left:5ch;
}

@keyframes type {
  from { width: 0; }
}

@keyframes pulse {  0%, 100% {      color: white; /* Initial color */  }  20% {       color: var(--nav-hover-color); /* Color at midpoint */  }}
.pulse-text {  animation: pulse 4s infinite; /* Adjust duration as needed */}

</style>

	<div class="text-center container p-3 fs-1 font-biscuit-tin ">
	SKILLSET 
	</div>
 
	    <div class="posts-grid"  >
          <div class="row gy-4">
      

 

         

        



         
{% for title,data in skills.items() %}

                  <div class="col-md-6 p-4" >
              <article class="grid-post"  >
               
               <h2 class="font-maria fw-bolder article-title text-uppercase text-center fs-1">{{title}}</h2>
               <div class="container">
               	<div class="row">
              {%for skill_item in data%}
              	<div class="col-6 col-lg-4 p-1  font-maria ">
              		<div class="skill-box text-uppercase font-pixelify pulse-text">
              			
              	{{ skill_item }}
              		</div>
              </div>
              {% endfor %}
               		
               	</div>
               </div>
               

          <div class="row">
          	<div class="col-2 p-3">
          		
          	</div>
          </div>
    

              </article>
            </div>

{% endfor %}
                   
          </div>
        </div>

{% endblock %}