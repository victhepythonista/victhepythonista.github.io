{% extends "./base.jinja" %}
{% block content %}
<style>
	table{
		border-radius: 20px !important;
		background-color:var(--nav-hover-color)!important;
		color: black !important;

	}
	td{
		 color:var(--nav-hover-color)!important;
		background-color: black !important;

	}
	tr{
		border:0px solid ;
		border-bottom:2px solid var(--nav-hover-color);
	}

	/* Top-left and top-right corners */
table tr:first-child td:first-child {
  border-top-left-radius: 12px;
}

table tr:first-child td:last-child {
  border-top-right-radius: 12px;
}

/* Bottom-left and bottom-right corners */
table tr:last-child td:first-child {
  border-bottom-left-radius: 12px;
}

table tr:last-child td:last-child {
  border-bottom-right-radius: 12px;
}

	.grid-post{
  background-color:var(--nav-hover-color);
  color:#343232;
  padding: 10px;
  border-radius: 20px;
	}

	.grid-post h2{
		color:#343232 !important;
	}

	.grid-post h3 , h4 , h5{
		color: #0c0e2f !important;
	}

    .service-title{
  width: 20ch; /* SHORTCUT: 18ch equals exactly 18 characters wide */
  white-space: nowrap;
  overflow: hidden;
  animation: type 6s steps(20) infinite; /* Matches character count exactly */
  display: flex;
  transition:all ease-in-out;
  text-align: center;
  padding-left:5ch;
}

@keyframes type {
  from { width: 0; }
}
</style>

	<div class="text-center container p-3 fs-1 font-biscuit-tin">
	 $ERVICE$ I OFFER 
	</div>
 
	    <div class="posts-grid">
          <div class="row gy-4">
      

 

            <div class="col-md-6 p-4"  >
              <article class="grid-post"  >
               
               <h2 class="font-dasher  fs-1  text-center service-title">WEBSITES</h2>
               <h4 class="font-dunkin"> </h4>
               

  
    <table class="table table-striped table-hover align-middle mb-0">
      <tbody>

      	{% for  service in services.website_development  %}
        <tr class="font-maria">
          <td>{{service.title}}</td>
          <td>{{service.description}}</td>
          <td>{{service.duration}}</td>
        </tr>

{% endfor %}
        

        
         

         
      </tbody>
    </table>

              </article>
            </div>

        



                  <div class="col-md-6 p-4"  >
              <article class="grid-post"  >
               
               <h2 class="font-dasher text-center service-title fs-1">APPS</h2>
               <h5 class="font-maria">Practical and user-friendly applications  tailored to your specific needs.</h5>
               


    <table class="table table-striped table-hover align-middle mb-0">
      <tbody>

      	{% for  service in services.app_development  %}
        <tr class="font-maria">
          <td>{{service.title}}</td>
          <td>{{service.description}}</td>
          <td>{{service.price}}</td>
        </tr>

{% endfor %}
        

        
         

         
      </tbody>
    </table>

              </article>
            </div>





                  <div class="col-md-6 p-4"  >
              <article class="grid-post"  >
               
               <h2 class="font-dasher text-center fs-1 service-title">WEB SCRAPING</h2>
               <h4 class="font-maria">Need data from the internet ? Do you want it stored, converted, routed elsewhere or visualized? I got you !</h4>
               <h5 class="font-maria">I am experienced in making efficient  un-blockable web crawlers built with user-friendliness in mind</h5>
               

               <h2 class="text-center font-dunkin fs-1 "> From 15$</h2>
    

              </article>
            </div>


                  <div class="col-md-6 p-4"  >
              <article class="grid-post"  >
               
               <h2 class="font-dasher text-center fs-1 service-title">GRAPHICS</h2>
               <h4 class="font-maria">Banners, brochures, flyers, invitations, logos and promotional materials. Expect clean designs, strong visual layouts, and branding that helps your business communicate effectively and stand out.</h4>
               

               <h2 class="text-center font-dunkin fs-1 "> From 10$</h2>
    

              </article>
            </div>


                  <div class="col-md-6 p-4"  >
              <article class="grid-post"  >
               
               <h2 class="font-dasher text-center fs-1 service-title">DEBUGGING</h2>
               <h4 class="font-maria">Finding bugs, testing , vulnerability checks, validating user interactions,  checking compatibility .....   
 
                </h4>
               <h4 class="font-maria">
                 
                  I also fix/improve/update AI generated code within my coding knowledge 
               </h4>

               <h2 class="text-center font-dunkin fs-1 "> From 1$</h2>
    

              </article>
            </div>
          </div>
        </div>

{% endblock %}